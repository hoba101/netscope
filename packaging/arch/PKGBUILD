# Maintainer: miro (hoba101) <hoba101@users.noreply.github.com>
pkgname=netscope
pkgver=1.0.0
pkgrel=1
pkgdesc='Professional network usage monitor with history recovery'
arch=('any')
url='https://github.com/hoba101/netscope'
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
optdepends=('vnstat: long-term Linux usage history')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # update for published release

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/usr/lib/netscope" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/icons/hicolor/scalable/apps" "$pkgdir/usr/share/metainfo"
  cp -a netscope "$pkgdir/usr/lib/netscope/"
  cat > "$pkgdir/usr/bin/netscope" <<'EOF'
#!/usr/bin/bash
export PYTHONPATH=/usr/lib/netscope${PYTHONPATH:+:$PYTHONPATH}
exec /usr/bin/python3 -m netscope "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/netscope"
  install -Dm644 netscope.desktop "$pkgdir/usr/share/applications/io.github.hoba101.NetScope.desktop"
  install -Dm644 assets/icons/hicolor/scalable/apps/io.github.hoba101.NetScope.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hoba101.NetScope.svg"
  install -Dm644 io.github.hoba101.NetScope.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.hoba101.NetScope.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
